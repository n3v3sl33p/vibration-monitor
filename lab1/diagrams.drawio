            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="fn" value="Готовность модели = она обучена, настройки совместимы; иначе нужно переобучение.&lt;br&gt;Проверка параметров — до генерации. Ошибка → сообщение и возврат к настройкам.&lt;br&gt;Нет/неверен ключ → запрет записи или чтения, без частично сохранённых строк.&lt;br&gt;Настройка порогов и итоговая оценка выполняются на разных запусках." style="whiteSpace=wrap;html=1;spacing=10;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#687787;strokeWidth=1.5;fontFamily=Arial;fontSize=16;fontColor=#17212b;shape=note;size=14;" vertex="1" parent="1">
          <mxGeometry x="35" y="1650" width="1170" height="85" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
